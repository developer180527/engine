diff --git a/include/bx/platform.h b/include/bx/platform.h
index 72a3622..d2f25c7 100644
--- a/include/bx/platform.h
+++ b/include/bx/platform.h
@@ -83,9 +83,14 @@
 #endif //
 
 // http://sourceforge.net/apps/mediawiki/predef/index.php?title=Architectures
-#if defined(__arm__)     \
- || defined(__aarch64__) \
- || defined(_M_ARM)
+// _M_ARM64 / _M_ARM64EC added (engine patch). MSVC on ARM64 defines _M_ARM64 and
+// NEVER __aarch64__ (a GCC/Clang macro), and _M_ARM is the 32-BIT ARM macro — so
+// this list did not recognise ARM64 Windows as ARM at all.
+#if defined(__arm__)      \
+ || defined(__aarch64__)  \
+ || defined(_M_ARM)       \
+ || defined(_M_ARM64)     \
+ || defined(_M_ARM64EC)
 #	undef  BX_CPU_ARM
 #	define BX_CPU_ARM 1
 #	define BX_CACHE_LINE_SIZE 64
@@ -120,9 +125,28 @@
 #	define BX_CACHE_LINE_SIZE 64
 #endif //
 
+// _M_ARM64 / _M_ARM64EC added (engine patch), and this one had teeth. Without
+// them MSVC ARM64 fell to the 32-bit branch, and a few lines below that decides
+// the Windows API level:
+//
+//     #if BX_ARCH_64BIT   -> WINVER/_WIN32_WINNT 0x0601   (Windows 7)
+//     #else               -> WINVER/_WIN32_WINNT 0x0502   (XP SP2 / Server 2003)
+//
+// So every bgfx translation unit on ARM64 Windows compiled against an XP-era SDK
+// surface: NTDDI_VERSION 0x05020000, below NTDDI_VISTA. The SDK then gates out
+// every Vista+ declaration, which is why renderer_d3d12.cpp could include
+// <shlobj.h> successfully and still report "SHGetKnownFolderPath is not a member
+// of '`global namespace''" and "KF_FLAG_DEFAULT: undeclared identifier".
+//
+// Measured, not guessed: a #pragma message in pix3_win.h printed
+// NTDDI_VERSION=0x05020000 on the arm64 leg and 0x06010000 on x64, in the same
+// run. Three attempts at that header failed because the header was never the
+// problem.
 #if defined(__x86_64__)    \
  || defined(_M_X64)        \
  || defined(__aarch64__)   \
+ || defined(_M_ARM64)      \
+ || defined(_M_ARM64EC)    \
  || defined(__64BIT__)     \
  || defined(__mips64)      \
  || defined(__powerpc64__) \
diff --git a/include/bx/simd_t.h b/include/bx/simd_t.h
index ef032d2..62d53f1 100644
--- a/include/bx/simd_t.h
+++ b/include/bx/simd_t.h
@@ -24,7 +24,21 @@
 #	define BX_SIMD_AVX 1
 #endif //
 
-#if defined(__SSE2__) || (BX_COMPILER_MSVC && (BX_ARCH_64BIT || _M_IX86_FP >= 2) )
+// BX_CPU_X86 added to the MSVC arm (engine patch). This read "MSVC and 64-bit"
+// and meant "x86-64" — a fair assumption until Windows on ARM64, where it
+// concludes SSE2 is available on an ARM target and includes an x86 intrinsics
+// header: "emmintrin.h(20): fatal error C1189: #error: This header is specific
+// to X86, X64, ARM64, and ARM64EC targets".
+//
+// This surfaced only after the companion patch taught bx that MSVC ARM64 IS
+// 64-bit (bgfx.cmake+bx__arm64-msvc-arch-detection.patch) — before that,
+// BX_ARCH_64BIT was 0 here and the bug was masked by a different one.
+//
+// MSVC ARM64 now falls through to no SIMD, exactly as it did before that patch,
+// because the NEON arm below wants __ARM_NEON__ and MSVC defines _M_ARM64 with
+// <arm64_neon.h> instead. Reference scalar paths are correct, and teaching bx
+// MSVC NEON is upstream's call, not a CI fix.
+#if defined(__SSE2__) || (BX_COMPILER_MSVC && BX_CPU_X86 && (BX_ARCH_64BIT || _M_IX86_FP >= 2) )
 #	include <emmintrin.h> // __m128i
 #	if defined(__SSE4_1__)
 #		include <smmintrin.h>
