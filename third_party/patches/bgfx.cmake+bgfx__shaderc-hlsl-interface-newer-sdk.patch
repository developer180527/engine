 #endif // defined(__MINGW32__)
 
 #define COM_NO_WINDOWS_H
+// COM_NO_WINDOWS_H suppresses the <windows.h> pull-in, and on Windows SDK
+// 10.0.26100 (shipped with VS 18) that path no longer leaves `interface`
+// defined. d3dcommon.h line 58 is `typedef interface ID3D10Blob ID3D10Blob;`,
+// so every COM forward-declaration in d3dcommon.h / oaidl.h / objidl.h becomes
+// "error C2146: syntax error: missing ';'" and the compile stops at 100 errors.
+// `interface` is a plain `struct` alias in the SDK; defining it here is what
+// combaseapi.h would have done. Guarded, so an SDK that still defines it wins.
+#if defined(_MSC_VER) && !defined(interface)
+#	define interface struct
+#endif
 #if BX_PLATFORM_LINUX || BX_PLATFORM_OSX
 #	include <wsl/winadapter.h>
